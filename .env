PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/expense-tracker
ENABLE_TRANSACTIONS=false
ENABLE_ICON_FETCH=true
DEFAULT_ICON_URL=https://example.com/default-icon.png
DEFAULT_IMAGE_URL=https://example.com/default-image.png
CRON_AUTO_DEDUCTION=0 2 * * *
DISABLE_CRON=false
CRON_DAILY_EMAIL=0 8 * * *
CRON_MONTHLY_EMAIL=0 9 1 * *
DISABLE_EMAIL_CRON=false
JWT_SECRET=myaccesssecret123
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASS=your_pass
SMTP_FROM=Expense Tracker <no-reply@example.com>
