PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/expense-tracker
ENABLE_TRANSACTIONS=true
ENABLE_ICON_FETCH=true
DEFAULT_ICON_URL=https://example.com/default-icon.png
DEFAULT_IMAGE_URL=https://example.com/default-image.png
CRON_AUTO_DEDUCTION=0 2 * * *
# Set true on extra BE replicas so only one instance runs jobs (Mongo lock is also used).
DISABLE_CRON=false
CRON_DAILY_EMAIL=0 8 * * *
CRON_MONTHLY_EMAIL=0 9 1 * *
DISABLE_EMAIL_CRON=false
JWT_SECRET=change-me-to-a-long-random-secret
# Optional 64-char hex (32 bytes) for AES-256-GCM. If empty, derived from JWT_SECRET.
ENCRYPTION_KEY=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173
# Optional: POST JSON alerts for cron failures / elevated 5xx
MONITORING_WEBHOOK_URL=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASS=your_pass
SMTP_FROM=Expense Tracker <no-reply@example.com>
