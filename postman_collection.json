              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/telegram/income",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"cash\",\n  \"amount\": 500,\n  \"note\": \"Telegram income\",\n  \"date\": \"2026-05-06\"\n}"
            }
          }
        },
        {
          "name": "Telegram Add Expense",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/telegram/expense",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"cash\",\n  \"amount\": 100,\n  \"note\": \"Telegram expense\",\n  \"date\": \"2026-05-06\"\n}"
            }
          }
        },
        {
          "name": "Telegram Transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/telegram/transfer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transferType\": \"bank_to_cash\",\n  \"fromBankId\": \"{{bankId}}\",\n  \"amount\": 300,\n  \"note\": \"Telegram transfer\",\n  \"date\": \"2026-05-06\"\n}"
            }
          }
        },
        {
          "name": "Telegram Get Balances",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/telegram/balances"
          }
        }
